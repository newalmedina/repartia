# ============================================================
#  Repartia · .env de PRODUCCIÓN (plantilla)
#  Copiar a .env en el servidor y rellenar los valores ***
#  NUNCA subir el .env real al repositorio.
# ============================================================

APP_NAME=Repartia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://repartia.tudominio.com
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Base de datos (MySQL en la red docker "web") ---
# DB_HOST = nombre del contenedor de MySQL dentro de la red "web"
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=repartia
DB_USERNAME=***
DB_PASSWORD=***

# --- Colas: las procesa el worker de supervisor ---
QUEUE_CONNECTION=database

# --- Sesión / caché ---
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file

FILESYSTEM_DISK=public

# --- Correo (recuperar contraseña, etc.) ---
MAIL_MAILER=smtp
MAIL_HOST=***
MAIL_PORT=587
MAIL_USERNAME=***
MAIL_PASSWORD=***
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Suplantar usuario: a dónde ir al suplantar ---
FILAMENT_IMPERSONATE_REDIRECT=/
